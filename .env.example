# CarbonX environment template
# Copy this file to .env for local development.
# Never commit real credentials, private keys, service-account files, or tokens.

# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Python backend (backend/.env)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5000,http://localhost:5173,http://localhost:3000
REDIS_URL=redis://localhost:6379/0
# Password for the Docker-network Redis (docker-compose.yml). Must be set
# explicitly for a server deployment; the default below is for local dev only.
CARBONX_REDIS_PASSWORD=carbonx-dev-redis-only

# Payments (simulated default, or razorpay)
# ONE gate everywhere (startup validation, /payments/checkout,
# /marketplace/buy): CARBONX_ACCEPT_SIMULATED_PAYMENTS=1 is the explicit
# opt-in that enables simulated checkout. The legacy
# CARBONX_ALLOW_SIMULATED_SETTLEMENT variable still works as a deprecated
# alias but is deprecated — do not reference it in new tooling/docs.
CARBONX_PAYMENTS_PROVIDER=simulated
CARBONX_ACCEPT_SIMULATED_PAYMENTS=0
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Monitoring & Security
CARBONX_MONITOR_SECRET=your-monitoring-cron-secret
CARBONX_ENVIRONMENT=development
CARBONX_AUTO_MONITOR=1
CARBONX_FORCE_HTTPS=0
CARBONX_JSON_LOGS=1
CARBONX_NDVI_DROP_ALERT=0.15

# Optional Frontend API Base URLs (defaults to proxy /py-api and /bc-api)
# VITE_PY_API_BASE=https://your-api.railway.app
# VITE_BC_API_BASE=http://your-blockchain-node:3001

# SMS OTP via Textplate (https://api.textplate.in/v1/send-sms)
TEXTPLATE_API_TOKEN=your-textplate-api-token
TEXTPLATE_TEMPLATE_ID=your-template-id
TEXTPLATE_EXPIRY_VALUE=3
TEXTPLATE_DETAIL_VALUE=CarbonX login

# Voice agent (Sarvam AI) — read by backend/app/voice_agent/voice_routes.py
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_DEFAULT_LANGUAGE=te-IN
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_CHAT_MODEL=sarvam-105b-conversations

# Local development only: returns the OTP in the API response (no SMS sent).
# Never set this in production.
CARBONX_ALLOW_DEV_OTP=

# Google Earth Engine
GEE_PROJECT=your-google-earth-engine-project
GEE_KEY_PATH=path/to/gee-service-account.json

# Azure document processing (optional)
AZURE_URL=https://your-resource.cognitiveservices.azure.com/
AZURE_DOC_KEY=your-azure-document-intelligence-key

# Email notifications (optional)
EMAIL_ADDRESS=your-email@example.com
EMAIL_APP_PASSWORD=your-email-app-password

# Node blockchain backend (backend/.env)
PORT=3001
RPC_URL=https://your-rpc-provider.example
CARBON_CREDIT_ADDRESS=0x0000000000000000000000000000000000000000
MARKETPLACE_ADDRESS=0x0000000000000000000000000000000000000000
MINTER_PRIVATE_KEY=your-minter-private-key
BUYER_PRIVATE_KEY=your-buyer-private-key
GEE_MICROSERVICE_URL=http://localhost:5001

# Supabase Management API / seed script (optional)
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
