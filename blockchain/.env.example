# Blockchain (Polygon Amoy testnet) — copy to .env, NEVER commit real keys
# Get test MATIC from the Amoy faucet: https://faucet.polygon.technology/
RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_ID=80002
# Deployer (needs test MATIC for gas) — use a burner wallet for testnet
DEPLOYER_PRIVATE_KEY=your_testnet_only_private_key
# Filled in by `npx hardhat run scripts/deploy.js --network amoy`:
CARBON_CREDIT_ADDRESS=
MARKETPLACE_ADDRESS=
# Backend mint/buy service (backend/.env): RPC_URL + both addresses + MINTER_PRIVATE_KEY
